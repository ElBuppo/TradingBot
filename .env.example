# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# Server-side refusal fallback (retries a declined request on a recommended model)
ENABLE_REFUSAL_FALLBACK=true
# Let the Research stage use Claude's web search tool
RESEARCH_WEB_SEARCH=true

# --- Alpaca (https://app.alpaca.markets -> Paper trading -> API keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# sim   = local simulated broker (no orders leave your machine)
# paper = Alpaca paper account
# live  = REAL MONEY. Also requires ALLOW_LIVE_TRADING=yes and the --live CLI flag.
TRADING_MODE=sim
ALLOW_LIVE_TRADING=no

# --- Watchlist & hard risk limits (enforced in code, AI cannot override) ---
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,SPY,QQQ
MAX_CANDIDATES=3
MAX_POSITION_PCT=10
MAX_RISK_PER_TRADE_PCT=1
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=3
MIN_REWARD_RISK=1.5
MIN_CONVICTION=6
MAX_REVISION_ROUNDS=2
SIM_STARTING_CASH=100000
